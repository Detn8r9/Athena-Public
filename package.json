{
  "name": "project-athena-root",
  "private": true,
  "description": "Proxies npm scripts to the athena/ app — run from repo root or cd athena",
  "scripts": {
    "dev": "npm --prefix athena run dev",
    "build": "npm --prefix athena run build",
    "test": "npm --prefix athena run test",
    "preview": "npm --prefix athena run preview",
    "verify-catalog": "npm --prefix athena run verify-catalog --",
    "verify-catalog-probe": "npm --prefix athena run verify-catalog-probe --",
    "audit-local": "npm --prefix athena run audit-local --",
    "prune-partials": "npm --prefix athena run prune-partials --",
    "tauri": "npm --prefix athena run tauri --",
    "tauri:dev": "npm --prefix athena run tauri -- dev",
    "tauri:build": "npm --prefix athena run tauri -- build"
  }
}
