# Cross-compilation image for ATHENA Tauri builds (Linux host in Docker → Windows MSVC + Linux targets).
# Usage: see build_cross.sh at the repository root.

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PKG_CONFIG_ALLOW_CROSS=1
ENV PKG_CONFIG_PATH=/usr/lib/x86_64-linux-gnu/pkgconfig

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    build-essential \
    pkg-config \
    cmake \
    clang \
    lld \
    llvm \
    xdg-utils \
    libfuse2 \
    libssl-dev \
    libsqlite3-dev \
    libwebkit2gtk-4.1-dev \
    libjavascriptcoregtk-4.1-dev \
    libsoup-3.0-dev \
    libgtk-3-dev \
    libudev-dev \
    libayatana-appindicator3-dev \
    librsvg2-dev \
    patchelf \
    gcc-x86-64-linux-gnu \
    g++-x86-64-linux-gnu \
    file \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get update \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

ENV RUSTUP_HOME=/usr/local/rustup
ENV CARGO_HOME=/usr/local/cargo
ENV PATH=/usr/local/cargo/bin:$PATH

RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --default-toolchain stable \
    && rustup target add \
        x86_64-pc-windows-msvc \
        x86_64-unknown-linux-gnu \
        aarch64-unknown-linux-gnu

RUN printf '%s\n' \
    '[target.x86_64-unknown-linux-gnu]' \
    'linker = "x86_64-linux-gnu-gcc"' \
    >> /usr/local/cargo/config.toml

RUN cargo install cargo-xwin

# Pre-fetch MSVC/Windows SDK for cargo-xwin and add mixed-case symlinks. The SDK ships
# lowercase `directml.lib` / `pathcch.lib` and all-caps `DIRECTML.lib` aliases; `lld-link`
# expects `DirectML.lib` and `PathCch.lib`, which must exist on case-sensitive Linux FS.
RUN export PATH=/usr/local/cargo/bin:$PATH \
    && cargo xwin cache xwin \
    && cd /root/.cache/cargo-xwin/xwin/sdk/lib/um/x86_64 \
    && ln -sf directml.lib DirectML.lib \
    && ln -sf pathcch.lib PathCch.lib

WORKDIR /workspace
