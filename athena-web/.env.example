# Athena Web — copy to .env

ATHENA_HOST=0.0.0.0
ATHENA_PORT=8080
ATHENA_PUBLIC_URL=http://localhost:8080

# Cloud LLMs via LiteLLM (tried first when online)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Preferred cloud model when keys are present
ATHENA_CLOUD_MODEL=openai/gpt-4o-mini

# Local Ollama failover (strict — used when cloud fails or offline)
OLLAMA_BASE_URL=http://ollama:11434
ATHENA_LOCAL_MODEL=qwen2.5:0.5b

# Optional ComfyUI
COMFYUI_BASE_URL=http://comfyui:8188

# Voice sidecars (module-managed containers published on the host)
WHISPER_BASE_URL=http://host.docker.internal:9000
KOKORO_BASE_URL=http://host.docker.internal:8880

# Module / peer discovery (CIDR fallback when interface detection is empty)
ATHENA_DATA_DIR=/data
ATHENA_CATALOG_DIR=/app/catalogs
ATHENA_PEER_SCAN_CIDRS=192.168.0.0/24,10.0.0.0/24
ATHENA_PEER_SCAN_PORT=8080
ATHENA_PEER_SCAN_CONCURRENCY=32
ATHENA_PEER_SCAN_TIMEOUT_MS=500
ATHENA_PEER_SCAN_MAX_HOSTS=254

# Docker app store (host socket mounted in compose)
DOCKER_HOST=unix:///var/run/docker.sock
