{
  "name": "athena",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "verify-catalog": "node scripts/verify-catalog.mjs",
    "verify-catalog-probe": "node scripts/verify-catalog.mjs --probe",
    "audit-local": "ts-node scripts/audit-local.ts",
    "prune-partials": "ts-node scripts/prune-partials.ts",
    "tauri": "tauri",
    "icon": "node scripts/squircle-mask.mjs branding/athena-icon-square.png branding/athena-icon-squircle.png && tauri icon branding/athena-icon-squircle.png",
    "icon:mask": "node scripts/squircle-mask.mjs",
    "audit:backend": "npm run build && (cd src-tauri && cargo check) && (cd src-tauri && cargo test)",
    "audit:e2e": "node scripts/run-tauri-e2e.mjs",
    "audit:full": "npm run audit:backend && npm run audit:e2e"
  },
  "dependencies": {
    "@hyvilo/maplibre-gl-draw": "^1.0.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "2.6.0",
    "@tauri-apps/plugin-opener": "^2",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.577.0",
    "maplibre-gl": "^5.6.0",
    "pdf-lib": "^1.17.1",
    "pmtiles": "^4.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tauri-plugin-macos-permissions-api": "^2.3.0",
    "zustand": "^5.0.12"
  },
  "ts-node": {
    "project": "scripts/tsconfig.json"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@tauri-apps/cli": "^2",
    "@tauri-apps/cli-darwin-arm64": "2.10.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.5.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.14",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.2.4",
    "tailwindcss-animate": "^1.0.7",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.0.9"
    ,
    "@wdio/cli": "^9.19.0",
    "@wdio/local-runner": "^9.19.0",
    "@wdio/mocha-framework": "^9.19.0",
    "@wdio/spec-reporter": "^9.19.0",
    "@wdio/globals": "^9.19.0"
  }
}
