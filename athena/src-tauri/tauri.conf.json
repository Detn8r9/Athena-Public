{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ATHENA",
  "version": "0.1.0",
  "identifier": "com.athena.micro",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ATHENA",
        "width": 800,
        "height": 600,
        "maximizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "bin/pmtiles",
      "bin/tesseract",
      "bin/pdftoppm",
      "bin/kiwix-serve",
      "ollama"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/embedding",
      "resources/reranker",
      "resources/tessdata/*",
      "payload/**/*"
    ]
  }
}
