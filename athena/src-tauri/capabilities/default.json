{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window. USB export uses Rust std::fs in the backend (not tauri-plugin-fs scopes); macOS writes to /Volumes/... depend on OS volume permissions and app packaging, not this capability list.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "ollama",
          "sidecar": true,
          "args": true
        },
        {
          "name": "kiwix-serve",
          "sidecar": true,
          "args": true
        }
      ]
    },
    {
      "identifier": "shell:allow-kill",
      "allow": [
        {
          "name": "ollama",
          "sidecar": true
        },
        {
          "name": "kiwix-serve",
          "sidecar": true
        }
      ]
    }
  ]
}
