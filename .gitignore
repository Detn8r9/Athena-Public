# --- OS & junk ---
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini
*~

# --- Secrets & local env (never ship) ---
.env
.env.*
!.env.example
!.env.*.example
athena/.env.local
athena/.satellite-key.local
# Local app config snapshots (may contain API keys)
athena_config.json
athena/athena_config.json
*.pem
*.key
*.p12
*.pfx
secrets/
credentials.json
*-credentials.json

# --- Node / frontend (regenerate with npm install) ---
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
*.tsbuildinfo
.eslintcache

# --- Vite / bundler output (rebuild with npm run build) ---
dist/
dist-ssr/
**/dist/
**/dist-ssr/

# --- Rust / Cargo (rebuild with cargo build) ---
target/
**/target/
**/.cargo-target-phase4/
# Custom CARGO_TARGET_DIR trees under athena/src-tauri (local builds; multi-GB)
athena/src-tauri/target-check/
athena/src-tauri/target-local/
athena/src-tauri/target-local-agent/
athena/src-tauri/target-local-agent-check/
athena/src-tauri/target-phase2b/
athena/src-tauri/target-local-check/

# --- Tauri generated ---
**/gen/schemas/

# Large Protomaps CLI binaries (provision locally; do not commit)
athena/src-tauri/bin/

# --- Tests & coverage ---
coverage/
.nyc_output/
*.lcov

# --- Logs ---
logs/
*.log

# --- Editor / IDE (optional local settings) ---
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Merge / patch leftovers ---
*.orig
*.rej

# --- Large local data (mirrors .cursorignore; Athena / IDE stabilization) ---
AthenaData/
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db
*.zim
*.zip
*.tar
*.pbf
*manifest.json

# --- Cursor: keep shared rules, drop local logs/state ---
.cursor/*
!.cursor/rules/
!.cursor/rules/**

# --- Personal / machine-specific (avoid committing) ---
*.code-workspace
.envrc
.direnv/
**/*.local.json
**/*.private.json
**/personal/
**/user-profile-local/
athena/**/screenshots/
athena/**/.env.local

# --- Workspace lockdown (IDE + file watchers) ---
src-tauri/target/
*.part

# Local reference clones (not part of Athena product)
reference/
